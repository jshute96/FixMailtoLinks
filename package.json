{
  "name": "FixMailtoLinks",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that replaces mailto links with configurable links to other sites",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "test": "node scripts/build.mjs && playwright test",
    "test:headed": "node scripts/build.mjs && playwright test --headed",
    "clean": "rm -rf dist test-results playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
